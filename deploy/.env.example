# Public URL guests open (must be https and resolve to this server).
SHAREBOX_PUBLIC_URL=https://share.example.org
SHAREBOX_LISTEN=:443
# Let's Encrypt certificate for the public URL (needs ports 80 and 443).
SHAREBOX_AUTOCERT=1
SHAREBOX_ACME_EMAIL=admin@example.org

# Embedded TURN relay (strongly recommended).
SHAREBOX_TURN=1
SHAREBOX_TURN_PUBLIC_IP=203.0.113.10
# Generate with: openssl rand -base64 32
SHAREBOX_TURN_SECRET=change-me
SHAREBOX_TURN_UDP=:3478
SHAREBOX_TURN_TCP=:3478
SHAREBOX_TURN_PORTS=49160-49999

# Optional: direct HTTPS to hosts (requires delegating a DNS zone to this
# server; see docs/deploy-server.md). Leave empty to disable.
SHAREBOX_DIRECT_ZONE=
SHAREBOX_DNS_NS=
